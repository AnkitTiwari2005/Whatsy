# Dependencies — install with: npm install
node_modules/

# Build output — dist/ IS committed so Hostinger Git deploy works without a build step
# After code changes: npm run build, then commit dist/ and push

# WhatsApp session files (live on server at DATA_DIR/auth_state/)
auth_state/

# Local SQLite database and data dir (live on server at DATA_DIR/)
data/

# Environment secrets — copy .env.example and fill in values, never commit .env
.env

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db