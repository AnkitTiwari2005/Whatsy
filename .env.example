# ── Required ─────────────────────────────────────────────────────────────
PORT=3000
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_KEY=change-me-to-something-long-and-random-before-deploying
# Persistent directory OUTSIDE the deploy tree (holds whatsy.db, auth_state/, otp.secret)
DATA_DIR=./data
# Always set in production (disables dev-only pretty logging)
NODE_ENV=production

# ── Behind a reverse proxy? (Hostinger, nginx, Cloudflare…) ──────────────
# Number of proxy hops in front of the app. Without this every visitor shares the proxy's IP,
# so rate limits and the admin-key lockout apply to everyone at once.
TRUST_PROXY=1

# ── WhatsApp / numbers ───────────────────────────────────────────────────
WA_PHONE_NUMBER=
# Optional: country code (digits) so local numbers like 98765 43210 or 098765 43210 become +91…
DEFAULT_COUNTRY_CODE=

# ── Queue & delivery ─────────────────────────────────────────────────────
MESSAGE_DELAY_MIN_MS=2000
MESSAGE_DELAY_MAX_MS=5000
MAX_QUEUE_SIZE=100
SEND_TIMEOUT_MS=20000
SEND_MAX_ATTEMPTS=3
MAX_MESSAGE_LENGTH=4096

# ── OTP policy ───────────────────────────────────────────────────────────
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
# OTP_SECRET=            # optional (16+ chars); otherwise generated into DATA_DIR/otp.secret

# ── Hardening / limits ───────────────────────────────────────────────────
# CORS is OFF by default (server-to-server calls and the admin UI don't need it).
# Only if a browser app on another origin must call the API: CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_MESSAGES_PER_MIN=60
RATE_LIMIT_OTP_PER_MIN=30
ADMIN_FAIL_MAX=10
ADMIN_FAIL_WINDOW_SEC=900

# ── Privacy ──────────────────────────────────────────────────────────────
# true = store "[redacted]" instead of message text (messages cannot be re-sent after a crash)
REDACT_BODIES=false
# Delete sent/failed messages older than N days (0 = keep forever)
MESSAGE_RETENTION_DAYS=0
LOG_LEVEL=info
