# Required
PORT=3000
ADMIN_KEY=change-me-to-something-long-and-random-before-deploying

# Path to persistent data directory (set this on Hostinger!)
# Hostinger (shudhham.in): /home/u392157842/whatsy_data
DATA_DIR=./data

# WhatsApp pairing — set to your dedicated number (E.164, digits only, no + or spaces)
# e.g. 919876543210 for +91 98765 43210
WA_PHONE_NUMBER=

# Message sending jitter (milliseconds)
MESSAGE_DELAY_MIN_MS=2000
MESSAGE_DELAY_MAX_MS=5000

# Max messages to hold in memory while WhatsApp is disconnected
MAX_QUEUE_SIZE=100

# Set to "true" to omit message body text from the message log
REDACT_BODIES=false

# Log level: debug | info | warn | error
LOG_LEVEL=info
