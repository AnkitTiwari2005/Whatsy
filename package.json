{
    "name": "whatsy",
    "version": "1.0.0",
    "description": "Self-hosted WhatsApp notification API",
    "main": "dist/index.js",
    "scripts": {
        "build": "echo dist/ is pre-built, skipping compile",
    "build:local": "tsc && npm run copy-assets",
        "copy-assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/db',{recursive:true});fs.mkdirSync('dist/admin-ui',{recursive:true});fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql');fs.copyFileSync('src/admin-ui/index.html','dist/admin-ui/index.html');console.log('Assets copied.')\"",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "lint": "tsc --noEmit"
    },
    "dependencies": {
        "@hapi/boom": "^10.0.1",
        "@whiskeysockets/baileys": "^7.0.0-rc14",
        "bcryptjs": "^2.4.3",
        "better-sqlite3": "^9.6.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.0.1",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.0.0",
        "pino": "^9.5.0",
        "pino-pretty": "^11.3.0",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/better-sqlite3": "^7.6.12",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "@types/qrcode": "^1.5.5",
        "tsx": "^4.19.2",
        "typescript": "^5.7.0"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "allowScripts": {
        "@whiskeysockets/baileys@7.0.0-rc14": true,
        "protobufjs@7.6.6": true,
        "esbuild@0.28.2": true
    }
}
